{
  "name": "multiagentpoc-root",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run start-client\" \"npm run start-server\"",
    "start-client": "cd client && npm start",
    "start-server": "nodemon --exec ts-node --project server/tsconfig.json server/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "3.1.10",
    "ts-node": "10.9.2"
  },
  "dependencies": {
    "react-markdown": "^10.1.0"
  }
}
